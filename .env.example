TZ=Europe/Brussels
PUID=1000
PGID=1000

# macOS development:
MEDIA_ROOT=./data/media
DOWNLOAD_ROOT=./data/downloads
COMPOSE_FILE=compose.yml:compose.gpu.yml

# Raspberry Pi:
# MEDIA_ROOT=/mnt/nvme/media
# DOWNLOAD_ROOT=/mnt/nvme/downloads
# COMPOSE_FILE=compose.yml:compose.gpu.yml:compose.tailscale.yml

# Tailscale (Linux/Raspberry Pi only). Use a one-off auth key; the node identity
# persists in a Docker volume after the first successful login.
TAILSCALE_HOSTNAME=planelab
TAILSCALE_AUTHKEY=

# Generate unique values; never commit the real .env file.
MARIADB_ROOT_PASSWORD=replace-with-a-long-random-password
YOUTARR_DB_PASSWORD=replace-with-another-long-random-password

# Create this in Remux under Dashboard -> API Keys. PlaneLab uses it to update
# the per-user catalog filter whenever the operating mode changes.
REMUX_URL=http://localhost:8096
REMUX_API_KEY=replace-with-remux-api-key
# Remux addon kinds treated as offline/local catalogs (comma-separated).
REMUX_LOCAL_ADDON_KINDS=opendal-local

# auto: enable an already installed Pi hotspot in travel mode; on/off: force.
PLANELAB_TRAVEL_HOTSPOT=auto

# auto exposes an Intel/AMD DRI render device on non-Pi Linux; Remux configures
# its own encoding. off disables device passthrough.
PLANELAB_GPU_PASSTHROUGH=auto
