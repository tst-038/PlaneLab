# Copy to hotspot.env and change at least HOTSPOT_PASSWORD.
HOTSPOT_SSID=PlaneLab
HOTSPOT_PASSWORD=replace-with-a-strong-password
HOTSPOT_INTERFACE=wlan0
HOTSPOT_CONNECTION=planelab-hotspot
HOTSPOT_ADDRESS=10.42.0.1/24
HOTSPOT_BAND=a
HOTSPOT_CHANNEL=36
HOTSPOT_HIDDEN=yes
WIFI_COUNTRY=BE

# Optional provisioning uplink. Running `./hotspot.sh uplink` temporarily
# disables the hotspot and connects wlan0 to this network.
UPLINK_SSID=replace-with-uplink-ssid
UPLINK_PASSWORD=replace-with-uplink-password
UPLINK_INTERFACE=wlan0
UPLINK_CONNECTION=planelab-uplink
UPLINK_HIDDEN=no
