# Copy to hotspot.env and change at least HOTSPOT_PASSWORD.
HOTSPOT_SSID=PlaneLab
HOTSPOT_PASSWORD=replace-with-a-strong-password
HOTSPOT_INTERFACE=wlan0
HOTSPOT_CONNECTION=planelab-hotspot
HOTSPOT_ADDRESS=10.42.0.1/24
HOTSPOT_BAND=a
HOTSPOT_CHANNEL=36
HOTSPOT_HIDDEN=yes
WIFI_COUNTRY=BE

# Optional uplink settings. The SSID and password are supplied directly to
# `./hotspot.sh uplink`; they do not need to be stored in this file.
UPLINK_INTERFACE=wlan0
UPLINK_CONNECTION=planelab-uplink

# Ethernet can receive networking from a router (auto) or provide DHCP to a
# directly connected device (shared). Smart mode detects which one is needed.
ETHERNET_INTERFACE=eth0
ETHERNET_CONNECTION=planelab-ethernet
ETHERNET_SHARED_ADDRESS=10.42.1.1/24
ETHERNET_SMART_WATCH=yes
ETHERNET_WATCH_SERVICE=planelab-ethernet-watch.service
