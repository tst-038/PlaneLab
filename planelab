#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

if ((BASH_VERSINFO[0] >= 4)); then
  ESC_TIMEOUT="0.05"
else
  # Bash 3.2 (the macOS system Bash) accepts integer read timeouts only.
  ESC_TIMEOUT="1"
fi

if [[ -t 1 ]]; then
  RESET=$'\033[0m'
  BOLD=$'\033[1m'
  DIM=$'\033[2m'
  CYAN=$'\033[36m'
  GREEN=$'\033[32m'
  YELLOW=$'\033[33m'
  RED=$'\033[31m'
else
  RESET="" BOLD="" DIM="" CYAN="" GREEN="" YELLOW="" RED=""
fi

title() {
  clear 2>/dev/null || true
  printf '%s\n' "${CYAN}${BOLD}"
  printf '  ╭──────────────────────────────────────────╮\n'
  printf '  │              ✈  PLANELAB                 │\n'
  printf '  │       offline media control center       │\n'
  printf '  ╰──────────────────────────────────────────╯\n'
  printf '%s\n' "${RESET}"
}

pause() {
  printf '\n%s' "${DIM}Press Enter to continue…${RESET}"
  read -r _
}

confirm() {
  local answer
  printf '%s [y/N] ' "$1"
  read -r answer
  [[ "$answer" == "y" || "$answer" == "Y" ]]
}

arrow_menu() {
  local options count selected key sequence index answer
  options=("$@")
  count="${#options[@]}"
  selected=0

  if [[ ! -t 0 || ! -t 1 ]]; then
    for index in "${!options[@]}"; do
      printf '  [%d] %s\n' "$((index + 1))" "${options[$index]}"
    done
    read -r -p "  › " answer
    if [[ "$answer" == "q" || "$answer" == "Q" ]]; then
      MENU_CHOICE=-1
    elif [[ "$answer" =~ ^[0-9]+$ ]] &&
      ((answer >= 1 && answer <= count)); then
      MENU_CHOICE=$((answer - 1))
    else
      MENU_CHOICE=$((count - 1))
    fi
    return
  fi

  printf '  %sUse ↑/↓ or j/k, Enter to select, Esc to go back%s\n\n' "$DIM" "$RESET"
  while true; do
    for index in "${!options[@]}"; do
      if [[ "$index" -eq "$selected" ]]; then
        printf '\033[2K  %s❯ %-42s%s\n' "$CYAN$BOLD" "${options[$index]}" "$RESET"
      else
        printf '\033[2K    %-42s\n' "${options[$index]}"
      fi
    done

    read -r -s -n 1 key
    case "$key" in
      $'\033')
        sequence=""
        read -r -s -n 2 -t "$ESC_TIMEOUT" sequence || true
        case "$sequence" in
          '[A') selected=$(((selected - 1 + count) % count)) ;;
          '[B') selected=$(((selected + 1) % count)) ;;
          '') MENU_CHOICE=-1; printf '\n'; return ;;
        esac
        ;;
      k|K) selected=$(((selected - 1 + count) % count)) ;;
      j|J) selected=$(((selected + 1) % count)) ;;
      q|Q) MENU_CHOICE=-1; printf '\n'; return ;;
      '') MENU_CHOICE="$selected"; printf '\n'; return ;;
      [1-9])
        if ((key <= count)); then
          MENU_CHOICE=$((key - 1))
          printf '\n'
          return
        fi
        ;;
    esac
    printf '\033[%dA' "$count"
  done
}

require_docker() {
  if ! command -v docker >/dev/null 2>&1 ||
    ! docker compose version >/dev/null 2>&1; then
    printf '%s\n' "${RED}Docker Engine with Compose is required.${RESET}" >&2
    return 1
  fi
}

require_config() {
  if [[ ! -f .env ]]; then
    printf '%s\n' "${RED}.env is missing. Run Setup first.${RESET}" >&2
    return 1
  fi
}

stack_state() {
  if ! command -v docker >/dev/null 2>&1; then
    printf '%s' "${RED}Docker missing${RESET}"
  elif [[ ! -f .env ]]; then
    printf '%s' "${YELLOW}not configured${RESET}"
  elif docker compose ps --status running --quiet 2>/dev/null | grep -q .; then
    printf '%s' "${GREEN}running${RESET}"
  else
    printf '%s' "${YELLOW}stopped${RESET}"
  fi
}

hotspot_state() {
  if ! command -v nmcli >/dev/null 2>&1; then
    printf '%s' "${DIM}not available${RESET}"
  elif nmcli -t -f NAME connection show --active 2>/dev/null |
    grep -Fxq "planelab-hotspot"; then
    printf '%s' "${GREEN}active${RESET}"
  else
    printf '%s' "${YELLOW}inactive${RESET}"
  fi
}

mode_state() {
  if [[ -x "$SCRIPT_DIR/mode.sh" ]]; then
    "$SCRIPT_DIR/mode.sh" status 2>/dev/null
  else
    printf 'not set'
  fi
}

gpu_state() {
  if [[ -x "$SCRIPT_DIR/gpu-passthrough.sh" ]]; then
    "$SCRIPT_DIR/gpu-passthrough.sh" status 2>/dev/null
  else
    printf 'not configured'
  fi
}

remove_legacy_jellyfin() {
  if docker inspect jellyfin >/dev/null 2>&1; then
    printf '%s\n' "${YELLOW}Removing the legacy Jellyfin container; its volumes are preserved.${RESET}"
    docker rm -f jellyfin >/dev/null
  fi
}

random_secret() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 24
  else
    od -An -N24 -tx1 /dev/urandom | tr -d ' \n'
  fi
}

setup_stack() {
  local media_default downloads_default media_root download_root
  local existing_root_password existing_youtarr_password
  local existing_travel_hotspot existing_gpu
  require_docker || return

  existing_root_password=""
  existing_youtarr_password=""
  existing_travel_hotspot=""
  existing_gpu=""
  if [[ -f .env ]]; then
    existing_root_password="$(
      sed -n 's/^MARIADB_ROOT_PASSWORD=//p' .env | tail -n 1
    )"
    existing_youtarr_password="$(
      sed -n 's/^YOUTARR_DB_PASSWORD=//p' .env | tail -n 1
    )"
    existing_travel_hotspot="$(
      sed -n 's/^PLANELAB_TRAVEL_HOTSPOT=//p' .env | tail -n 1
    )"
    existing_gpu="$(
      sed -n 's/^PLANELAB_GPU_PASSTHROUGH=//p' .env | tail -n 1
    )"
    if [[ -z "$existing_gpu" ]]; then
      existing_gpu="$(sed -n 's/^PLANELAB_HARDWARE_TRANSCODING=//p' .env | tail -n 1)"
    fi
  fi

  if [[ -f .env ]] && ! confirm ".env already exists. Replace it?"; then
    printf 'Keeping existing .env.\n'
  else
    if [[ "$(uname -s)" == "Linux" ]]; then
      media_default="/mnt/nvme/media"
      downloads_default="/mnt/nvme/downloads"
    else
      media_default="./data/media"
      downloads_default="./data/downloads"
    fi

    read -r -p "Media path [$media_default]: " media_root
    read -r -p "Downloads path [$downloads_default]: " download_root
    media_root="${media_root:-$media_default}"
    download_root="${download_root:-$downloads_default}"

    if [[ "$media_root" == *$'\n'* || "$download_root" == *$'\n'* ]]; then
      printf '%s\n' "${RED}Paths may not contain newlines.${RESET}" >&2
      return 1
    fi

    {
      printf 'TZ=Europe/Brussels\n'
      printf 'PUID=%s\n' "$(id -u)"
      printf 'PGID=%s\n\n' "$(id -g)"
      printf 'MEDIA_ROOT=%s\n' "$media_root"
      printf 'DOWNLOAD_ROOT=%s\n\n' "$download_root"
      if [[ "$(uname -s)" == "Linux" && -f compose.tailscale.yml ]]; then
        printf 'COMPOSE_FILE=compose.yml:compose.gpu.yml:compose.tailscale.yml\n'
      else
        printf 'COMPOSE_FILE=compose.yml:compose.gpu.yml\n'
      fi
      printf 'MARIADB_ROOT_PASSWORD=%s\n' \
        "${existing_root_password:-$(random_secret)}"
      printf 'YOUTARR_DB_PASSWORD=%s\n' \
        "${existing_youtarr_password:-$(random_secret)}"
      printf 'PLANELAB_TRAVEL_HOTSPOT=%s\n' \
        "${existing_travel_hotspot:-auto}"
      printf 'PLANELAB_GPU_PASSTHROUGH=%s\n' "${existing_gpu:-auto}"
    } > .env
    chmod 600 .env
    printf '%s\n' "${GREEN}Created private .env with random database passwords.${RESET}"
  fi

  media_root="$(sed -n 's/^MEDIA_ROOT=//p' .env | tail -n 1)"
  download_root="$(sed -n 's/^DOWNLOAD_ROOT=//p' .env | tail -n 1)"
  if [[ -z "$media_root" || -z "$download_root" ]]; then
    printf '%s\n' "${RED}.env must define MEDIA_ROOT and DOWNLOAD_ROOT.${RESET}" >&2
    return 1
  fi

  # Compose creates relative development paths itself. Pi storage is prepared
  # explicitly and only when its parent filesystem is actually mounted.
  if [[ "$(uname -s)" == "Linux" ]]; then
    if [[ "$media_root" == /mnt/nvme/* || "$download_root" == /mnt/nvme/* ]]; then
      if ! mountpoint -q /mnt/nvme; then
        printf '%s\n' "${RED}/mnt/nvme is not mounted; refusing to start.${RESET}" >&2
        return 1
      fi
      sudo mkdir -p \
        "$media_root/offline/movies" "$media_root/offline/shows" \
        "$media_root/YouTube" \
        "$download_root/incomplete" \
        "$download_root/complete/radarr" "$download_root/complete/sonarr"
      sudo chown -R "$(id -u):$(id -g)" "$media_root" "$download_root"
    fi
  else
    mkdir -p \
      "$media_root/offline/movies" "$media_root/offline/shows" \
      "$media_root/YouTube" \
      "$download_root/incomplete" \
      "$download_root/complete/radarr" "$download_root/complete/sonarr"
  fi

  ./prepare.sh
  "$SCRIPT_DIR/gpu-passthrough.sh" configure
  remove_legacy_jellyfin
  docker compose config --quiet
  docker compose pull
  case "$(mode_state)" in
    home|prepare|travel) "$SCRIPT_DIR/mode.sh" "$(mode_state)" ;;
    *)
      docker compose up -d
      ;;
  esac
  docker compose ps
}

mode_menu() {
  while true; do
    title
    printf '  %sOPERATING MODE%s\n\n' "$BOLD" "$RESET"
    printf '  Current: %s\n\n' "$(mode_state)"
    arrow_menu \
      "Home — Remux playback only" \
      "Prepare — download on the Pi" \
      "Travel — Remux playback and hotspot"
    case "$MENU_CHOICE" in
      0) title; "$SCRIPT_DIR/mode.sh" home || true; pause ;;
      1) title; "$SCRIPT_DIR/mode.sh" prepare || true; pause ;;
      2) title; "$SCRIPT_DIR/mode.sh" travel || true; pause ;;
      -1) return ;;
    esac
  done
}

start_stack() {
  local current_mode
  require_docker && require_config || return
  current_mode="$(mode_state)"
  ./prepare.sh
  "$SCRIPT_DIR/gpu-passthrough.sh" configure
  remove_legacy_jellyfin
  case "$current_mode" in
    home|prepare|travel) "$SCRIPT_DIR/mode.sh" "$current_mode" ;;
    *)
      docker compose up -d
      ;;
  esac
}

restart_running_services() {
  local current_mode running_services service_name
  require_docker && require_config || return
  "$SCRIPT_DIR/gpu-passthrough.sh" configure
  remove_legacy_jellyfin
  current_mode="$(mode_state)"
  running_services=()
  while IFS= read -r service_name; do
    [[ -n "$service_name" ]] && running_services+=("$service_name")
  done < <(docker compose ps --status running --services)
  if [[ "${#running_services[@]}" -eq 0 ]]; then
    printf '%s\n' "${YELLOW}No PlaneLab services are running.${RESET}"
    return
  fi
  docker compose restart "${running_services[@]}"
  # Reapply the selected mode after restarting. This starts any required core
  # service that was missing or stopped, including the optional Tailscale node.
  case "$current_mode" in
    home|prepare|travel) "$SCRIPT_DIR/mode.sh" "$current_mode" ;;
    *) docker compose up -d ;;
  esac
}

update_stack() {
  require_docker && require_config || return
  docker compose pull
  start_stack
}

show_services() {
  require_docker && require_config || return
  docker compose ps
}

service_menu() {
  while true; do
    title
    printf '  %sSERVICES%s\n\n' "$BOLD" "$RESET"
    arrow_menu \
      "Start stack" \
      "Stop stack" \
      "Restart stack" \
      "Update images and restart" \
      "Show status" \
      "Follow logs"
    case "$MENU_CHOICE" in
      0) start_stack; pause ;;
      1) require_docker && require_config && docker compose stop; pause ;;
      2) restart_running_services; pause ;;
      3) update_stack; pause ;;
      4) show_services; pause ;;
      5)
        require_docker && require_config &&
          docker compose logs --tail=100 --follow
        ;;
      -1) return ;;
    esac
  done
}

restore_menu() {
  local backups labels selected replace_flag backup_path index
  backups=()
  labels=()
  while IFS= read -r backup_path; do
    backups+=("$backup_path")
    labels+=("$(basename -- "$backup_path")")
  done < <(
    find "$SCRIPT_DIR/backups" -mindepth 1 -maxdepth 1 -type d 2>/dev/null |
      sort -r
  )
  if [[ "${#backups[@]}" -eq 0 ]]; then
    printf '%s\n' "${YELLOW}No backups found in $SCRIPT_DIR/backups.${RESET}"
    return
  fi

  printf '%s\n\n' "${BOLD}AVAILABLE BACKUPS${RESET}"
  arrow_menu "${labels[@]}"
  index="$MENU_CHOICE"
  ((index >= 0)) || return
  ((index < ${#backups[@]})) || return
  selected="${backups[$index]}"

  if [[ -f .env ]]; then
    local restore_media_root restore_download_root
    restore_media_root="$(sed -n 's/^MEDIA_ROOT=//p' .env | tail -n 1)"
    restore_download_root="$(sed -n 's/^DOWNLOAD_ROOT=//p' .env | tail -n 1)"
    if [[ -z "$restore_media_root" || -z "$restore_download_root" ]]; then
      printf '%s\n' "${RED}.env must define MEDIA_ROOT and DOWNLOAD_ROOT.${RESET}" >&2
      return
    fi
    if { [[ "$restore_media_root" == /mnt/nvme/* ]] ||
         [[ "$restore_download_root" == /mnt/nvme/* ]]; } &&
       ! mountpoint -q /mnt/nvme; then
      printf '%s\n' "${RED}/mnt/nvme is configured but not mounted.${RESET}" >&2
      return
    fi
  fi

  replace_flag=""
  if confirm "Replace existing application volumes?"; then
    printf '%s\n' "${RED}This overwrites current app configuration.${RESET}"
    confirm "Continue with destructive restore?" || return
    replace_flag="--replace"
  fi
  ./restore.sh ${replace_flag:+"$replace_flag"} "$selected"
}

network_menu() {
  local ssid password
  while true; do
    title
    printf '  %sNETWORK%s\n\n' "$BOLD" "$RESET"
    arrow_menu \
      "Install/update PlaneLab hotspot" \
      "Start PlaneLab hotspot" \
      "Stop PlaneLab hotspot" \
      "Connect temporary Wi-Fi" \
      "Ethernet smart detect (recommended)" \
      "Ethernet receives network (auto)" \
      "Ethernet provides network (shared)" \
      "Network status"
    case "$MENU_CHOICE" in
      0) ./hotspot.sh install; pause ;;
      1) ./hotspot.sh up; pause ;;
      2) ./hotspot.sh down; pause ;;
      3)
        read -r -p "Wi-Fi name: " ssid
        read -r -s -p "Password: " password
        printf '\n'
        ./hotspot.sh uplink "$ssid" "$password"
        unset password
        pause
        ;;
      4) ./hotspot.sh ethernet smart; pause ;;
      5) ./hotspot.sh ethernet auto; pause ;;
      6) ./hotspot.sh ethernet shared; pause ;;
      7) ./hotspot.sh status; pause ;;
      -1) return ;;
    esac
  done
}

main_menu() {
  while true; do
    title
    printf '  Stack:   %s\n' "$(stack_state)"
    printf '  Mode:    %s\n' "$(mode_state)"
    printf '  GPU:     %s\n' "$(gpu_state)"
    printf '  Hotspot: %s\n\n' "$(hotspot_state)"
    arrow_menu \
      "First setup / reconfigure" \
      "Operating mode" \
      "Services" \
      "Create backup" \
      "Restore backup" \
      "Network" \
      "Service addresses" \
      "Quit"
    case "$MENU_CHOICE" in
      0) title; setup_stack; pause ;;
      1) mode_menu ;;
      2) service_menu ;;
      3) title; ./backup.sh; pause ;;
      4) title; restore_menu; pause ;;
      5) network_menu ;;
      6)
        title
        printf '  Remux     http://jellyfin.planelab\n'
        printf '  Remux alt http://remux.planelab\n'
        printf '  Seerr     http://seerr.planelab\n'
        printf '  Youtarr   http://youtarr.planelab\n'
        printf '  Sonarr    http://sonarr.planelab\n'
        printf '  Radarr    http://radarr.planelab\n'
        printf '  Prowlarr  http://prowlarr.planelab\n'
        printf '  SABnzbd   http://sabnzbd.planelab\n'
        printf '  RDTClient http://rdtclient.planelab\n'
        printf '\n  Direct IP and port addresses remain available as fallback.\n'
        pause
        ;;
      7|-1) title; printf '  Safe travels. ✈\n\n'; return ;;
    esac
  done
}

case "${1:-tui}" in
  tui) main_menu ;;
  setup) setup_stack ;;
  start) start_stack ;;
  stop) require_docker && require_config && docker compose stop ;;
  restart) restart_running_services ;;
  update) update_stack ;;
  status) show_services ;;
  logs) require_docker && require_config && docker compose logs --tail=100 --follow ;;
  backup) ./backup.sh ;;
  restore) shift; ./restore.sh "$@" ;;
  network) shift; ./hotspot.sh "$@" ;;
  mode) shift; ./mode.sh "$@" ;;
  gpu) shift; ./gpu-passthrough.sh "$@" ;;
  help|-h|--help)
    cat <<'EOF'
Usage: ./planelab [command]

Commands:
  tui (default)    Open the interactive control center
  setup            Configure and start PlaneLab
  start|stop|restart|update|status|logs
  backup
  restore [--replace] <backup-directory>
  network <hotspot-command>
  mode <home|prepare|travel|status>
  gpu <configure|status>
EOF
    ;;
  *)
    printf 'Unknown command: %s\n\n' "$1" >&2
    "$0" --help >&2
    exit 2
    ;;
esac
